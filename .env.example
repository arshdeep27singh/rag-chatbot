# OpenAI API Key (required if USE_LOCAL_MODEL=false)
OPENAI_API_KEY=your-api-key-here

# Set to "true" to use Ollama local models instead of OpenAI
USE_LOCAL_MODEL=false

# Ollama model name (used when USE_LOCAL_MODEL=true)
OLLAMA_MODEL=llama3

# Chunk size for document splitting
CHUNK_SIZE=500
CHUNK_OVERLAP=50
